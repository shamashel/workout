<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Cloud backup and device transfer use data_extraction_rules.xml on 12+. -->
<full-backup-content>
    <include domain="database" path="workout.db" />
    <include domain="database" path="workout.db-wal" />
    <include domain="database" path="workout.db-shm" />
    <include domain="sharedpref" path="." />
</full-backup-content>
