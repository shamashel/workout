<?xml version="1.0" encoding="utf-8"?>
<!--
  The Room file is the log, settings, and progression state.
  Health Connect exercise sessions live in the Health Connect app and are not files here.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="workout.db" />
        <include domain="database" path="workout.db-wal" />
        <include domain="database" path="workout.db-shm" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="workout.db" />
        <include domain="database" path="workout.db-wal" />
        <include domain="database" path="workout.db-shm" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
